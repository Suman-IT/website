# Copy to .env for local development. Set both MySQL passwords before Compose.
NODE_ENV=development
PORT=3000
# Exact browser origin; production must use HTTPS.
APP_ORIGIN=http://localhost:3000
MYSQL_DATABASE=skdora
MYSQL_USER=skdora_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Migration connection. Use a separate privileged migration account in production.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=skdora
DB_USER=skdora_app
DB_PASSWORD=
# One-time bootstrap inputs. Keep the password file outside this repository.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_PASSWORD_FILE=
# Optional override for the directory containing FEATURES.yaml and HOSPITAL_CONFIG.yaml.
# CONFIG_DIR=.
